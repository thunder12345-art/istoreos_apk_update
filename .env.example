APK_DIR=/mnt/sata1-1/TV
MODE=release
GITHUB_REPO=FongMi/Release
ASSET_PATTERN=leanback-armeabi_v7a.apk,mobile-arm64_v8a.apk
PROXY_PREFIX=https://gh-proxy.com/

# 固定名副本策略：auto = 保留附件原名(推荐)；留空 = 只留版本化文件；或指定单一文件名
STABLE_NAME=auto
KEEP_VERSIONS=3
# CHECK_INTERVAL_SECONDS=3600

