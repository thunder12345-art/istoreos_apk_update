APK_DIR=/mnt/sata1-1/TV
MODE=release
GITHUB_REPO=FongMi/Release
ASSET_PATTERN=leanback-armeabi_v7a.apk,mobile-arm64_v8a.apk
PROXY_PREFIX=https://gh-proxy.com/

# 额外目标(分号分隔): tag|匹配规则1,匹配规则2|archive
# module = tag 为 module 的 release, 所有 apk 直接按原始文件名保存(archive=0)
EXTRA_TARGETS=module|*.apk|0

# 固定名副本策略(仅 archive=1 的目标): auto = 保留附件原名(推荐)；留空 = 只留版本化文件；或指定单一文件名
STABLE_NAME=auto
KEEP_VERSIONS=1
CHECK_INTERVAL_SECONDS=86400

# --- 以下一般不用改 ---
# RAW_PATH=
# RAW_URL=
# RAW_BASE=https://raw.githubusercontent.com
# GITHUB_BRANCH=main
# VERSION_URL=
# RELEASE_TAG=
# INCLUDE_PRERELEASE=0
# FILE_STEM=
# RUN_ON_START=1
# RUN_ONCE=0
# REQUEST_TIMEOUT=30
# GITHUB_TOKEN=
