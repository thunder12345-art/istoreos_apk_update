# ===== 面板（浏览器访问 http://NAS地址:8898/） =====
# 面板首次启动用下面的配置生成 data/config.json；之后所有修改以面板为准
PANEL_PORT=8898
# PANEL_TOKEN=            # 面板访问口令（留空=局域网免密）

# NAS 数据盘根目录（映射为容器内 /nas，面板里用 /nas/xxx 选择保存位置）
NAS_ROOT=/mnt/data_sda1

# ===== 初始下载配置（首次启动生效，之后请在面板里改） =====
DOWNLOAD_DIR=/nas/TV
MODE=release
GITHUB_REPO=FongMi/Release
ASSET_PATTERN=leanback-armeabi_v7a.apk,mobile-arm64_v8a.apk
# 额外目标(分号分隔)，格式：
#   1) tag|匹配规则|archive                      （默认仓库，如 module 目标）
#   2) 仓库|tag|匹配规则|archive                 （跨仓库，仓库留空=默认仓库）
#   3) 仓库|tag|匹配规则|archive|旧版本清理模板  （第5段可选，* = 版本位，
#      如 runtime-mpv-*-arm64-v8a.apk；留空 = 自动识别点分版本号）
# 每个目标自动保存到 DOWNLOAD_DIR/<子文件夹>，默认「仓库-tag」，面板里可改
EXTRA_TARGETS=module|*.apk|0;pass-with-high-score/universal-installer||*.apk|1
PROXY_PREFIX=https://gh-proxy.com/
STABLE_NAME=auto
KEEP_VERSIONS=1
# 检查间隔（天）；0 = 不自动检查（仅面板手动「立即检查」）
CHECK_INTERVAL_DAYS=1
# 每天几点检查（0-23，例如 10 = 每天10点；留空 = 从上次检查起算间隔）
CHECK_HOUR=10

# --- 以下一般不用改 ---
# RAW_PATH=
# RAW_URL=
# RAW_BASE=https://raw.githubusercontent.com
# GITHUB_BRANCH=main
# VERSION_URL=
# RELEASE_TAG=
# INCLUDE_PRERELEASE=0
# FILE_STEM=
# RUN_ON_START=1
# RUN_ONCE=0
# REQUEST_TIMEOUT=30
# GITHUB_TOKEN=
