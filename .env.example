# ===== 面板（浏览器访问 http://NAS地址:8898/） =====
# 面板首次启动用下面的配置生成 data/config.json；之后所有修改以面板为准
PANEL_PORT=8898
# PANEL_TOKEN=            # 面板访问口令（留空=局域网免密）

# NAS 数据盘根目录（映射为容器内 /nas，面板里用 /nas/xxx 选择保存位置）
NAS_ROOT=/mnt/data_sda1

# ===== 初始下载配置（首次启动生效，之后请在面板里改） =====
DOWNLOAD_DIR=/nas/TV
MODE=release
GITHUB_REPO=FongMi/Release
ASSET_PATTERN=leanback-armeabi_v7a.apk,mobile-arm64_v8a.apk
EXTRA_TARGETS=module|*.apk|0
PROXY_PREFIX=https://gh-proxy.com/
STABLE_NAME=auto
KEEP_VERSIONS=1
CHECK_INTERVAL_SECONDS=86400

# --- 以下一般不用改 ---
# RAW_PATH=
# RAW_URL=
# RAW_BASE=https://raw.githubusercontent.com
# GITHUB_BRANCH=main
# VERSION_URL=
# RELEASE_TAG=
# INCLUDE_PRERELEASE=0
# FILE_STEM=
# RUN_ON_START=1
# RUN_ONCE=0
# REQUEST_TIMEOUT=30
# GITHUB_TOKEN=
